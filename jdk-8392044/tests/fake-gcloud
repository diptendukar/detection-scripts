#!/usr/bin/env bash
#
# Fake gcloud for run-gcp-tests.sh. Serves canned JSON from $FAKE_GCLOUD_DIR:
#
#   <project>/<word>.<word>...[_<key>].json   response on stdout, exit 0
#   <project>/<word>.<word>...[_<key>].err    message on stderr, exit 1
#   <word>.<word>....json                     project-independent response
#
# <word>s are the positional arguments (e.g. "run.services.list",
# "app.versions.describe.v1"); <key> is the value of --service or --location.
# "config get-value project" prints $FAKE_GCLOUD_PROJECT. Every call is
# appended to $FAKE_GCLOUD_LOG, and a call made while prompts are enabled
# fails, since the detector must never let gcloud prompt.

set -u
dir=${FAKE_GCLOUD_DIR:?}
project="" key="" words=""
all="$*"
while [ $# -gt 0 ]; do
    case "$1" in
        --project) project=$2; shift ;;
        --project=*) project=${1#*=} ;;
        --service|--location) key="${key}_$2"; shift ;;
        --format=*|--filter=*|--quiet) ;;
        --view) shift ;;
        --*) ;;
        *) words="${words:+$words.}$1" ;;
    esac
    shift
done
[ -n "${FAKE_GCLOUD_LOG:-}" ] && printf '%s\n' "$all" >> "$FAKE_GCLOUD_LOG"
if [ "${CLOUDSDK_CORE_DISABLE_PROMPTS:-}" != 1 ]; then
    echo "ERROR: fake-gcloud: prompts not disabled" >&2
    exit 1
fi
if [ "$words" = "config.get-value.project" ]; then
    printf '%s\n' "${FAKE_GCLOUD_PROJECT:-}"
    exit 0
fi
for f in "$dir/$project/$words$key" "$dir/$words$key"; do
    if [ -f "$f.json" ]; then cat "$f.json"; exit 0; fi
    if [ -f "$f.err" ]; then cat "$f.err" >&2; exit 1; fi
done
echo "ERROR: (gcloud.$words) fake-gcloud: no fixture $project/$words$key" >&2
exit 1
